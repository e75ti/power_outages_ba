# ==========================================
# Outage Scraper Configuration
# ==========================================

LOG_LEVEL=INFO
SCRAPE_INTERVAL_MINUTES=120
ENABLE_GEO_MATCHING=true

# --- OPTION A: Standalone Setup (Batteries Included) ---
# Uncomment the line below to tell Docker to spin up the local Postgres 18 container.
# COMPOSE_PROFILES=local-db,observability

POSTGRES_USER=outage_user
POSTGRES_PASSWORD=outage_secure_pass
POSTGRES_DB=outage_db
POSTGRES_PORT=5432

# --- OPTION B: Shared Infrastructure (Bring Your Own Database) ---
# If you are using a shared database (like your GRAS Postgres container), 
# leave COMPOSE_PROFILES commented out above, and define your custom URI here:
# DATABASE_URI=postgresql+psycopg://gras:password@host.docker.internal:5432/outage_db


GEOLOCATOR_EMAIL='youremail@email.com'

# --- Observability Settings (Optional) ---
# Suggested to change
GRAFANA_USER=admin

# Suggested to change
GRAFANA_PASSWORD=admin_secure_pass

# Can leave default
# GRAFANA_PORT=3000

# Can leave default
# PROMETHEUS_PORT=9090

# Can leave default
# LOKI_PORT=3100

