API_KEY=your_api_key_here
DATABASE_URL=your_database_url_here
NOTIFICATION_SERVICE_URL=your_notification_service_url_here
GEOCODING_API_KEY=your_geocoding_api_key_here
SUBSCRIPTION_SERVICE_URL=your_subscription_service_url_here

GEOLOCATOR_EMAIL=youremail@example.tld
# Firebase Configuration
FIREBASE_CREDENTIALS_PATH=./firebase-credentials.json
FIREBASE_PROJECT_ID=your-project-id

# Scraping Configuration
SCRAPE_INTERVAL_MINUTES=30
REQUEST_TIMEOUT=30
MAX_RETRIES=3

# Web Push (VAPID) Configuration
# Generate keys at: https://vapidkeys.com/
VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_CLAIMS_EMAIL=admin@yourdomain.com

# Geocoding
NOMINATIM_USER_AGENT=electricity-outage-scraper

# Geo Matching
ENABLE_GEO_MATCHING=true
GEO_MATCH_RADIUS_KM=5.0

# Logging
LOG_LEVEL=INFO
