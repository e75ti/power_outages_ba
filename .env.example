# ==========================================
# ⚡ BiH Power Alerts - Environment Config
# ==========================================

# --- Deployment Profiles ---
# Options: local-db, observability
# For a fresh standalone deployment, you MUST include 'local-db' to boot Postgres.
COMPOSE_PROFILES=local-db,observability

# --- Application Settings ---
LOG_LEVEL=INFO
SCRAPE_INTERVAL_MINUTES=30
ENABLE_GEO_MATCHING=true
GEOLOCATOR_EMAIL=admin@yourdomain.com

# --- Database ---
# When deploying standalone, leave DATABASE_URI empty so it defaults to the internal DB.
# DATABASE_URI=postgresql+psycopg://user:pass@host:5432/db
POSTGRES_USER=outage_admin
POSTGRES_PASSWORD=generate_a_secure_password_here
POSTGRES_DB=outage_db

# --- Integrations ---
TELEGRAM_BOT_TOKEN=your_telegram_token
TELEGRAM_ADMIN_ID=your_telegram_id
CLOUDFLARE_TUNNEL_TOKEN=your_cloudflare_tunnel_token

# --- Web Push (VAPID) ---
# Generate at https://vapidkeys.com
VAPID_PUBLIC_KEY=your_public_key
VAPID_PRIVATE_KEY=your_private_key
VAPID_CLAIMS_EMAIL=admin@yourdomain.com

# --- Observability ---
GRAFANA_USER=admin
GRAFANA_PASSWORD=secure_grafana_password
